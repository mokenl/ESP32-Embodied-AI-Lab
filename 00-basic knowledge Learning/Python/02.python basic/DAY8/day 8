# 1. 写入（w 会先清空原文件）
with open("Day8.txt", "w", encoding="utf-8") as f:
    f.write("第一行\n")
    f.write("第二行\n")
"""
with open(...) as f:
打开文件并把"文件对象"绑定给变量 f。with 的作用是：代码块一结束，自动调用 f.close()。哪怕中间报错，也会关。

"Day8.txt" —— 这是相对路径，相对于"当前工作目录"，不是脚本文件所在的目录。这是新手第一个大坑：脚本在 D:\code\,
你在 D:\ 下执行 python code\day8.py,文件会被创建在 D:\Day8.txt 而不是 D:\code\Day8.txt。想确认就用 print(os.getcwd())。

"w" —— 写模式。​文件不存在就创建，已存在就清空（就是上面那张图中间那一栏）。打开的一瞬间内容就没了，跟你写不写东西无关。

encoding="utf-8" —— 指定编码。不写的话 Windows 默认用 GBK,中文会乱码或直接报 UnicodeEncodeError.

f.write("第一行\n") —— 写入字符串。两个细节：

write() 不会自动换行，所以每行末尾必须手写 \n。不写的话两行会粘成 第一行第二行。
write() 有返回值（写入的字符数），这里是 4。平时不用它,但知道它"有返回值"能帮你区分它和 print.
"""


# 2. 追加（a 保留原内容，写在末尾）
with open("Day8.txt", "a", encoding="utf-8") as f:
    f.write("第三行\n")
"""
"a" —— 追加模式。文件不存在就创建，已存在就在末尾接着写，原内容不动。这是 w 和 a 的唯一区别，但后果天差地别：想给日志加一行用 a,
用 w 就把整个日志清空了.
"""


# 3. 一次读全部（小文件适用）
with open("Day8.txt", "r", encoding="utf-8") as f:
    print(f.read())
"""
"r" —— 只读模式。文件不存在会抛 FileNotFoundError。默认就是 r,但写出来更清楚。
print(f.read()) —— 这里有个容易忽略的细节：字符串本身已经以 \n 结尾,print 又补了一个换行，所以屏幕上多出一个空行。
f.read() —— 一口气读到文件末尾，返回一个完整的字符串：
"""


# 4. 逐行读（推荐，大文件不会一次性占满内存）
with open("Day8.txt", "r", encoding="utf-8") as f:
    for i, line in enumerate(f, 1):
        print(i, line.strip())
"""
for i, line in enumerate(f, 1): —— 文件对象本身就可以直接迭代,每次给你一行。enumerate(f, 1) 和 Day 5 学的完全一样，从 1 开始编号。
line.strip() —— 去掉字符串首尾的空白字符（\n、\r、空格、\t 都算）。
不去的话,print 输出完 line 自带的换行后，又补一个换行，结果每行之间都会多出一个空行
print(i, line.strip()) —— 两个参数用空格连接，所以是 1 第一行，中间一个空格
"""


"""
