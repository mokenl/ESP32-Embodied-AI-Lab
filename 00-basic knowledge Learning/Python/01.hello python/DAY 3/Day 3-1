"""
ESP32 Temperature Simulator

模拟ESP32读取温度数据
"""
# 模拟传感器数据

temperature_list = [
    25.5,
    26.2,
    31.5,
    35.8,
    28.3
]

print("ESP32 Temperature Monitor")
print("========================")

# for循环遍历温度列表，使用变量temperature表示当前温度值从temperature_list中取出；
for temperature in temperature_list:
    print(f"Current temperature:{temperature}℃")
    if temperature > 35:

        print("Warning: Temperature too high!")
    elif temperature >30:

        print("Attention: Temperature high")
    else:

        print("Temperature normal")
    print("----------------")

battery = 60
for temperature in temperature_list:

    print(
    f"""
        Temperature:{temperature}
        Battery:{battery}%
    """
    )
    battery -= 5