def greet(name):           # 1. 定义：说清楚"需要什么"
    print("Hello,", name)  # 2. 函数体：怎么处理
    return "OK"            # 3. 返回：交出什么

def show_tasks(tasks):
    for i, task in enumerate(tasks):        #enumerate 默认从 0 开始数，所以第 1 轮 i 是 0，不是 1。这就是下一行要写 i + 1 的原因。
        print(f"{i + 1}. {task['name']}")   #外层 f-string 用的是双引号，所以里层取字典的值必须用单引号 task['name']。
                                            #如果里层也写双引号，会变成 f"{task["name"]}"，Python 分不清哪里是字符串结尾

def add(x, y):
    return x + y

def add_one(lst):
    lst.append(100)      # 改的是同一个对象，外面会看到变化


nums = [1, 2, 3]
add_one(nums)
print(nums)               # [1, 2, 3, 100]
show_tasks([{"name": "读教程"}, {"name": "写代码"}, {"name": "写笔记"}])
greet("Moken")            # 调用函数，传入参数，得到返回值
print(add(1, 2))          # 调用函数，传入参数，得到返回值并打印返回值 

